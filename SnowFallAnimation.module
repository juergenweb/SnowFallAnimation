<?php
declare(strict_types=1);

namespace ProcessWire;

/*
 * SnowFallAnimation module for ProcessWire for creating and animating snowflakes on a web page
 * The JavaScript for the snowflakes is based on Snow Theme (https://github.com/ddosnotification/snow-theme, MIT License)
 *
 * Created by Jürgen Kern
 * https://github.com/juergenweb
 * File name: SnowFallAnimation.module
 * Created: 16.11.2025
 */

use DateTime;
use Exception;

class SnowFallAnimation extends WireData implements Module, ConfigurableModule
{

    // upper/lower limits for the settings (protect the visitors' browsers against extreme values)
    const MAX_DENSITY = 1000;
    const MIN_SIZE = 0.1;
    const MAX_SIZE = 10;
    const MIN_DURATION = 1;
    const MAX_DURATION = 120;

    protected string $dateFormat = 'Y-m-d';
    protected ?DateTime $dateStart = null;
    protected ?DateTime $dateEnd = null;
    protected DateTime $today;

    /**
     * Get all metadata for the module
     * @return array
     */
    public static function getModuleInfo(): array
    {
        return [
            'title' => 'SnowFallAnimation',
            'summary' => 'Module for creating and animating snowflakes on a web page.',
            'author' => "Jürgen Kern",
            'href' => 'https://github.com/juergenweb/SnowFallAnimation',
            'version' => '1.0.1',
            'singular' => true,
            'autoload' => true,
            'requires' => ['PHP>=8.0.0', 'ProcessWire>=3.0.181', 'LazyCron']
        ];
    }

    /**
     * Default values of all config settings (they match the defaults mentioned in the config form notes)
     * @return array
     */
    public static function getDefaultConfig(): array
    {
        return [
            'input_count' => 50,
            'input_minRadius' => 0.8,
            'input_maxRadius' => 1.5,
            'input_minSpeed' => 5,
            'input_maxSpeed' => 15,
            'input_text' => '❄,❅,❆',
            'input_color' => '#99ccff',
            'input_zIndex' => '1000',
            'input_visibility' => '0',
            'input_start' => '',
            'input_end' => '',
            'input_recurrence' => 0,
        ];
    }

    public function __construct()
    {
        parent::__construct();

        // set the defaults - ProcessWire overwrites them with the saved config data before init() is called
        foreach (self::getDefaultConfig() as $name => $value) {
            $this->set($name, $value);
        }
        $this->today = new DateTime('today');
    }

    /**
     * Method which runs before the render method
     * @return void
     */
    public function init(): void
    {
        $this->dateFormat = $this->_('Y-m-d'); // the default date format

        // create datetime objects of start date and end date (config data is available now)
        $this->dateStart = $this->toDate($this->input_start);
        $this->dateEnd = $this->toDate($this->input_end);

        $this->addHookAfter('Page::render', $this, 'addScript', ['priority' => 202]); // add snowfall scripts to the frontend
        $this->addHookBefore('Modules::saveConfig', $this, 'validateDates', ['priority' => 200]); // validate the config values before saving
        $this->addHookBefore('Inputfield::render', $this, 'openFieldset', ['priority' => 203]); // open the fieldset if there is an error in the children fields
        $this->addHookAfter('LazyCron::everyDay', $this, 'generateDates', ['priority' => 201]); // save the dates for the next year to the database
    }

    /**
     * Convert a timestamp (or a date string) into a DateTime object at midnight
     * @param mixed $value
     * @return DateTime|null
     */
    protected function toDate(mixed $value): ?DateTime
    {
        if ($value === null || $value === '' || $value === false || $value === 0 || $value === '0') return null;
        $value = (string)$value;
        $timestamp = ctype_digit($value) ? (int)$value : strtotime($value);
        if (!$timestamp) return null;
        try {
            return new DateTime(date('Y-m-d', $timestamp));
        } catch (Exception) {
            return null;
        }
    }

    /**
     * Add n years to a date, keeping day and month (29.02. becomes 28.02. in non-leap years)
     * @param DateTime $date
     * @param int $years
     * @return DateTime
     */
    protected function addYears(DateTime $date, int $years): DateTime
    {
        $year = (int)$date->format('Y') + $years;
        $month = (int)$date->format('n');
        $daysInMonth = (int)(new DateTime(sprintf('%04d-%02d-01', $year, $month)))->format('t');
        $day = min((int)$date->format('j'), $daysInMonth);
        return new DateTime(sprintf('%04d-%02d-%02d', $year, $month, $day));
    }

    /**
     * Check if the snowfall should be shown at the moment
     * @return bool
     */
    protected function isActive(): bool
    {
        return match ((int)$this->input_visibility) {
            1 => true,
            2 => $this->checkInRange(),
            default => false,
        };
    }

    /**
     * Check if the current date is inside the date range (the start date is included, the end date is excluded)
     * Works also if only one of the dates is set.
     * @return bool
     */
    protected function checkInRange(): bool
    {
        if ($this->dateStart && $this->today < $this->dateStart) return false;
        if ($this->dateEnd && $this->today >= $this->dateEnd) return false;
        return true;
    }

    /**
     * Limit a value to a range
     * @param int|float $value
     * @param int|float $min
     * @param int|float $max
     * @return int|float
     */
    protected function clamp(int|float $value, int|float $min, int|float $max): int|float
    {
        return max($min, min($max, $value));
    }

    /**
     * Get the sanitized configuration for the JavaScript
     * @return array
     */
    protected function getJsConfig(): array
    {
        $defaults = self::getDefaultConfig();

        $minSize = $this->clamp((float)$this->input_minRadius, self::MIN_SIZE, self::MAX_SIZE);
        $maxSize = $this->clamp((float)$this->input_maxRadius, self::MIN_SIZE, self::MAX_SIZE);
        if ($minSize > $maxSize) [$minSize, $maxSize] = [$maxSize, $minSize];

        $minDuration = (int)$this->clamp((int)$this->input_minSpeed, self::MIN_DURATION, self::MAX_DURATION);
        $maxDuration = (int)$this->clamp((int)$this->input_maxSpeed, self::MIN_DURATION, self::MAX_DURATION);
        if ($minDuration > $maxDuration) [$minDuration, $maxDuration] = [$maxDuration, $minDuration];

        $snowflakes = array_values(array_filter(array_map('trim', explode(',', (string)$this->input_text)), 'strlen'));
        if (!$snowflakes) $snowflakes = explode(',', $defaults['input_text']);

        $color = trim((string)$this->input_color);
        if (!preg_match('/^#([0-9a-f]{3}|[0-9a-f]{4}|[0-9a-f]{6}|[0-9a-f]{8})$/i', $color)) $color = $defaults['input_color'];

        $zIndex = trim((string)$this->input_zIndex);
        if (!preg_match('/^-?\d+$/', $zIndex)) $zIndex = $defaults['input_zIndex'];

        return [
            'density' => (int)$this->clamp((int)$this->input_count, 0, self::MAX_DENSITY),
            'minSize' => $minSize,
            'maxSize' => $maxSize,
            'minDuration' => $minDuration,
            'maxDuration' => $maxDuration,
            'snowflakes' => $snowflakes,
            'color' => $color,
            'zIndex' => (int)$zIndex,
        ];
    }

    /**
     * Add the JavaScript to the page
     * @param HookEvent $event
     * @return void
     */
    protected function addScript(HookEvent $event): void
    {
        $page = $event->object;

        // don't add this to the admin pages or ajax requests
        if ($page->template->name === 'admin' || $this->wire('config')->ajax) return;

        // check if script should be embedded or not
        if (!$this->isActive()) return;

        $html = $event->return;
        if (!is_string($html)) return;

        // only full HTML documents (no partial renders, no JSON/RSS output)
        $bodyPos = strripos($html, '</body>');
        if ($bodyPos === false) return;

        $version = $this->getModuleInfo()['version'];
        $url = $this->wire('config')->urls($this);

        // the config is passed as data attribute (no inline script, so it works with a strict Content-Security-Policy)
        $json = json_encode($this->getJsConfig(), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
        if ($json === false) return;
        $script = '<script src="' . $url . 'snow.min.js?v=' . $version . '" data-config="' . htmlspecialchars($json, ENT_QUOTES, 'UTF-8') . '"></script>' . PHP_EOL;

        $html = substr_replace($html, $script, $bodyPos, 0);

        $css = '<link rel="stylesheet" type="text/css" href="' . $url . 'snowfall.min.css?v=' . $version . '">' . PHP_EOL;
        $headPos = stripos($html, '</head>');
        if ($headPos !== false) {
            $html = substr_replace($html, $css, $headPos, 0);
        }

        $event->return = $html;
    }

    /**
     * Method to add some custom validation rules before the module config will be saved
     * @param HookEvent $event
     * @return void
     */
    protected function validateDates(HookEvent $event): void
    {
        // Get values of arguments sent to hook (and optionally modify them)
        $class = $event->arguments(0);
        $data = $event->arguments(1);

        // run only on this module and only if the whole config array will be saved
        $className = is_object($class) ? $class->className() : (string)$class;
        if ($className !== 'SnowFallAnimation' || !is_array($data)) return;

        // swap min and max values if they are in the wrong order
        foreach ([['input_minRadius', 'input_maxRadius'], ['input_minSpeed', 'input_maxSpeed']] as [$min, $max]) {
            if (isset($data[$min], $data[$max]) && (float)$data[$min] > (float)$data[$max]) {
                [$data[$min], $data[$max]] = [$data[$max], $data[$min]];
            }
        }

        // keep the values inside the allowed limits
        $limits = [
            'input_count' => [0, self::MAX_DENSITY, 'int'],
            'input_minRadius' => [self::MIN_SIZE, self::MAX_SIZE, 'float'],
            'input_maxRadius' => [self::MIN_SIZE, self::MAX_SIZE, 'float'],
            'input_minSpeed' => [self::MIN_DURATION, self::MAX_DURATION, 'int'],
            'input_maxSpeed' => [self::MIN_DURATION, self::MAX_DURATION, 'int'],
        ];
        foreach ($limits as $key => [$min, $max, $type]) {
            if (!isset($data[$key]) || $data[$key] === '') continue;
            $value = $type === 'int' ? (int)$data[$key] : (float)$data[$key];
            $data[$key] = $type === 'int' ? (int)$this->clamp($value, $min, $max) : (float)$this->clamp($value, $min, $max);
        }

        $dateStart = $this->toDate($data['input_start'] ?? '');
        $dateEnd = $this->toDate($data['input_end'] ?? '');
        $recurrence = !empty($data['input_recurrence']);
        $error = '';

        if ($dateStart && $dateEnd) {

            if ($dateStart > $dateEnd) {
                // 1) check if start date is before end date
                $error = $this->_('The end date must be after the start date.');
            } elseif ($dateEnd < $this->today) {
                // 2) check if end date is in the past
                $error = $this->_('The end date must be in the future not in the past.');
            } elseif ($recurrence && $dateStart->diff($dateEnd)->y >= 1) {
                // 3) check if date range is more than 1 year
                $error = $this->_('The difference between the start and end dates must be less than 1 year if you have recurrence enabled each year.');
            }

        } else {
            // uncheck recurring checkbox if it is marked, but there are not both dates (start and end) present
            $data['input_recurrence'] = 0;
        }

        if ($error) {
            // do not save the invalid dates - keep the previously saved values instead
            $oldConfig = $this->wire('modules')->getConfig($this);
            foreach (['input_start', 'input_end', 'input_recurrence'] as $key) {
                if (is_array($oldConfig) && array_key_exists($key, $oldConfig)) {
                    $data[$key] = $oldConfig[$key];
                } else {
                    $data[$key] = self::getDefaultConfig()[$key];
                }
            }
            $this->error($error . ' ' . $this->_('The previous dates have been kept.'));
            $this->wire('session')->set('snowfalldateserror', 1);
        }

        $event->arguments(1, $data);
    }

    /**
     * Method to save the start and end time for the next year if the end time is already in the past.
     * @param HookEvent $event
     * @return void
     */
    protected function generateDates(HookEvent $event): void
    {
        // run only if recurrence is enabled and both dates are present
        if ((int)$this->input_recurrence !== 1 || !$this->dateStart || !$this->dateEnd) return;

        // nothing to do if the end date is still in the future
        if ($this->dateEnd > $this->today) return;

        // add as many years as needed to get an end date in the future (if the cron did not run for a longer time)
        $years = 1;
        while ($this->addYears($this->dateEnd, $years) <= $this->today) {
            $years++;
        }
        $newDateStart = $this->addYears($this->dateStart, $years);
        $newDateEnd = $this->addYears($this->dateEnd, $years);

        // save the new dates to the database
        $config = $this->wire('modules')->getConfig($this);
        if (!is_array($config)) $config = [];
        $config['input_start'] = $newDateStart->getTimestamp();
        $config['input_end'] = $newDateEnd->getTimestamp();
        $this->wire('modules')->saveConfig($this, $config);

        $this->input_start = $config['input_start'];
        $this->input_end = $config['input_end'];
        $this->dateStart = $newDateStart;
        $this->dateEnd = $newDateEnd;
    }

    /**
     * Open the visibility fieldset if there was an error inside a child field
     * @param HookEvent $event
     * @return void
     */
    protected function openFieldset(HookEvent $event): void
    {
        // run only on fieldset 1
        $inputfield = $event->object;
        if (!$inputfield instanceof InputfieldFieldset || $inputfield->attr('name') !== 'fieldset1') return;

        // check if we are on the SnowfallAnimation module configuration page
        if ($this->wire('input')->get('name') !== 'SnowFallAnimation') return;

        if ($this->wire('session')->get('snowfalldateserror')) {
            $inputfield->collapsed = Inputfield::collapsedNo;
            $this->wire('session')->remove('snowfalldateserror');
        }
    }

    /**
     * Module config
     * @param InputfieldWrapper $inputfields
     * @throws WireException
     * @throws WirePermissionException
     */
    public function getModuleConfigInputfields(InputfieldWrapper $inputfields): void
    {

        // Markup element to indicate whether the snowfall is active or not
        $markup = $this->wire('modules')->get('InputfieldMarkup');

        // state: active (green), scheduled (yellow) or off (red)
        $scheduled = false;

        switch ((int)$this->input_visibility) {
            case 1:
                $content = $this->_('At the moment the snowfall is enabled.');
                $class = 'active';
                break;
            case 2:
                if ($this->checkInRange()) {
                    $class = 'active';
                    if ($this->dateEnd) {
                        $content = sprintf($this->_('At the moment the snowfall is enabled. It will be disabled on %s.'), $this->dateEnd->format($this->dateFormat));
                    } else {
                        $content = $this->_('At the moment the snowfall is enabled.');
                    }
                } else {
                    $class = 'inactive';
                    if ($this->dateStart && $this->dateStart > $this->today) {
                        $scheduled = true;
                        $content = sprintf($this->_('At the moment the snowfall is disabled. It will be enabled on %s automatically.'), $this->dateStart->format($this->dateFormat));
                    } else {
                        $content = $this->_('At the moment the snowfall is disabled.');
                    }
                }
                break;
            default:
                $class = 'inactive';
                $content = $this->_('At the moment the snowfall is disabled.');
        }

        // UIkit alert box (AdminThemeUikit)
        if ($class === 'active') {
            $alertClass = 'uk-alert-success';
            $icon = 'fa-check-circle';
        } elseif ($scheduled) {
            $alertClass = 'uk-alert-warning';
            $icon = 'fa-clock-o';
        } else {
            $alertClass = 'uk-alert-danger';
            $icon = 'fa-times-circle';
        }
        $markup->addClass('uk-text-large');
        $markup->markupText(
            '<div class="' . implode(' ', array_filter(['uk-alert', $alertClass, 'snowfall-state', $class])) . '" role="status">'
            . '<i class="fa fa-fw ' . $icon . '" aria-hidden="true"></i> '
            . htmlspecialchars($content, ENT_QUOTES, 'UTF-8')
            . '</div>'
        );
        $inputfields->add($markup);

        $fieldset1 = $this->wire('modules')->get('InputfieldFieldset');
        $fieldset1->attr('name', 'fieldset1');
        $fieldset1->label = $this->_('Activation/deactivation of the snowfall');
        $fieldset1->icon = 'fa-calendar';
        $fieldset1->description = $this->_('Activate/deactivate snowfall on the webpage.');
        $fieldset1->collapsed = Inputfield::collapsedYes;

        // Enable/disable the snowfall
        $visibility = $this->wire('modules')->get('InputfieldSelect');
        $visibility->attr('name', 'input_visibility');
        $visibility->label = $this->_('Enable/disable the snowfall');
        $visibility->description = $this->_('Enable/disable the snowfall manually or by date.');
        $options = [
            $this->_('Off'),
            $this->_('On'),
            $this->_('Enable/disable per date')
        ];
        $visibility->addOptions($options);
        $visibility->attr('value', $this->input_visibility);
        $visibility->required = 1;
        $fieldset1->add($visibility);

        // set the start date for the snowfall
        $start = $this->wire('modules')->get('InputfieldDatetime');
        $start->label = $this->_('Start date for the snowfall');
        $start->description = $this->_('Enter the date on which you want the snowfall to begin.');
        $start->attr('name', 'input_start');
        $start->datepicker = InputfieldDatetime::datepickerFocus;
        $start->columnWidth = 50;
        $start->dateInputFormat = $this->dateFormat;
        $start->showIf = 'input_visibility=2';
        $start->requiredIf = 'input_visibility=2';
        $start->attr('value', $this->input_start);
        $fieldset1->add($start);

        // set the end date for the snowfall
        $end = $this->wire('modules')->get('InputfieldDatetime');
        $end->label = $this->_('End date for the snowfall');
        $end->description = $this->_('Enter the date on which you want the snowfall to end.');
        $end->attr('name', 'input_end');
        $end->datepicker = InputfieldDatetime::datepickerFocus;
        $end->columnWidth = 50;
        $end->dateInputFormat = $this->dateFormat;
        $end->attr('value', $this->input_end);
        $end->showIf = 'input_visibility=2';
        $end->requiredIf = 'input_visibility=2';
        $fieldset1->add($end);

        // repeat the date settings every year
        $recurrence = $this->wire('modules')->get('InputfieldCheckbox');
        $recurrence->label = $this->_('Use these date settings (day and month) every year');
        $recurrence->description = $this->_('If you check the box, snowfall will be automatically activated and disabled on the specified days and months each year.');
        $recurrence->notes = $this->_('In this case, the snowfall begins and ends every year on the previously determined day and month.');
        $recurrence->attr('name', 'input_recurrence');
        $recurrence->showIf = "input_visibility=2,input_end!=''";
        if ((int)$this->input_recurrence === 1) {
            $recurrence->attr('checked', 'checked');
        }
        $fieldset1->add($recurrence);

        $inputfields->add($fieldset1);

        $fieldset2 = $this->wire('modules')->get('InputfieldFieldset');
        $fieldset2->attr('name', 'fieldset2');
        $fieldset2->label = $this->_('Styling and settings for the snowflakes');
        $fieldset2->icon = 'fa-cog';
        $fieldset2->description = $this->_('Make your global settings for the output of the snowflakes.');
        $fieldset2->collapsed = Inputfield::collapsedYes;

        // set the number of snowflakes
        $count = $this->wire('modules')->get('InputfieldInteger');
        $count->label = $this->_('Snow density');
        $count->description = $this->_('The number of snowflakes that are rendered on the page at any given time.');
        $count->notes = $this->_('Default value is 50. The higher the value, the denser the snowfall.');
        $count->attr('name', 'input_count');
        $count->attr('type', 'number');
        $count->attr('value', $this->input_count);
        $count->attr('min', 0);
        $count->attr('max', self::MAX_DENSITY);
        $count->required = 1;
        $fieldset2->add($count);

        // set the min size for the snowflakes
        $minRadius = $this->wire('modules')->get('InputfieldFloat');
        $minRadius->label = $this->_('Minimum size of the snowflakes (in em)');
        $minRadius->description = $this->_('Determine the minimum size of the snowflakes.');
        $minRadius->notes = $this->_('Default value is 0.8 em.');
        $minRadius->attr('name', 'input_minRadius');
        $minRadius->attr('min', self::MIN_SIZE);
        $minRadius->attr('max', self::MAX_SIZE);
        $minRadius->attr('type', 'number');
        $minRadius->attr('value', $this->input_minRadius);
        $minRadius->required = 1;
        $fieldset2->add($minRadius);

        // set the max size for the snowflakes
        $maxRadius = $this->wire('modules')->get('InputfieldFloat');
        $maxRadius->label = $this->_('Maximum size of the snowflakes (in em)');
        $maxRadius->description = $this->_('Determine the maximum size of the snowflakes.');
        $maxRadius->notes = $this->_('Default value is 1.5 em.');
        $maxRadius->attr('name', 'input_maxRadius');
        $maxRadius->attr('type', 'number');
        $maxRadius->attr('value', $this->input_maxRadius);
        $maxRadius->attr('min', self::MIN_SIZE);
        $maxRadius->attr('max', self::MAX_SIZE);
        $maxRadius->required = 1;
        $fieldset2->add($maxRadius);

        // set the min duration for the snowflakes
        $minSpeed = $this->wire('modules')->get('InputfieldInteger');
        $minSpeed->label = $this->_('Minimum fall duration (seconds)');
        $minSpeed->description = $this->_('Determine the minimum fall duration (the lower, the faster).');
        $minSpeed->notes = $this->_('Default value is 5 seconds.');
        $minSpeed->attr('name', 'input_minSpeed');
        $minSpeed->attr('type', 'number');
        $minSpeed->attr('value', $this->input_minSpeed);
        $minSpeed->attr('min', self::MIN_DURATION);
        $minSpeed->attr('max', self::MAX_DURATION);
        $minSpeed->required = 1;
        $fieldset2->add($minSpeed);

        // set the max duration for the snowflakes
        $maxSpeed = $this->wire('modules')->get('InputfieldInteger');
        $maxSpeed->label = $this->_('Maximum fall duration (seconds)');
        $maxSpeed->description = $this->_('Determine the maximum fall duration (the higher, the slower).');
        $maxSpeed->notes = $this->_('Default value is 15 seconds. Tipp: To create a realistic effect, min and max duration time should not be too far apart.');
        $maxSpeed->attr('name', 'input_maxSpeed');
        $maxSpeed->attr('type', 'number');
        $maxSpeed->attr('value', $this->input_maxSpeed);
        $maxSpeed->attr('min', self::MIN_DURATION);
        $maxSpeed->attr('max', self::MAX_DURATION);
        $maxSpeed->required = 1;
        $fieldset2->add($maxSpeed);

        // set the text for the snowflakes
        $text = $this->wire('modules')->get('InputfieldText');
        $text->label = $this->_('Snowflakes symbols');
        $text->description = $this->_('Please enter the different snowflakes separated by a comma.');
        $text->notes = sprintf($this->_('Default values are %s.'), '❄,❅,❆');
        $text->attr('name', 'input_text');
        $text->attr('type', 'text');
        $text->attr('value', $this->input_text);
        $text->required = 1;
        $fieldset2->add($text);

        // set the color for the snowflakes
        $color = $this->wire('modules')->get('InputfieldText');
        $color->label = $this->_('Color of a snowflake');
        $color->description = $this->_('Enter the color of the snowflakes in HEX format.');
        $color->notes = $this->_('Default value is #99ccff.');
        $color->attr('name', 'input_color');
        $color->attr('type', 'text');
        $color->attr('value', $this->input_color);
        $color->attr('pattern', '^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$');
        $color->required = 1;
        $fieldset2->add($color);

        // set the z-index for the snowflakes
        $zIndex = $this->wire('modules')->get('InputfieldText');
        $zIndex->label = $this->_('Z-Index for the snowflakes');
        $zIndex->description = $this->_('Change the Z-Index for the snowflakes if necessary.');
        $zIndex->notes = $this->_('Change this value if you have problems displaying the snowflakes. Default is 1000.');
        $zIndex->attr('name', 'input_zIndex');
        $zIndex->attr('type', 'text');
        $zIndex->attr('value', $this->input_zIndex);
        $zIndex->attr('pattern', '^-?[0-9]+$');
        $zIndex->required = 1;
        $fieldset2->add($zIndex);

        $inputfields->add($fieldset2);

    }

}
